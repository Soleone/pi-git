{
  "name": "pi-git",
  "version": "0.1.0",
  "description": "A namespaced Git workflow extension for pi",
  "type": "module",
  "keywords": [
    "pi",
    "extension",
    "pi-package",
    "pi-coding-agent",
    "tui",
    "git"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@soleone/showcase": "github:Soleone/showcase#658b1b5",
    "@types/node": "24.12.4",
    "diff": "5.2.0",
    "esbuild": "0.25.10",
    "isomorphic-git": "1.27.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm pack --dry-run",
    "demo:build": "node demo/browser/build.mjs && showcase terminal demo/browser --out dist/browser",
    "demo": "node demo/browser/build.mjs && showcase terminal demo/browser --out dist/browser --serve",
    "media:capture": "node demo/capture.mjs"
  },
  "files": [
    "index.ts",
    "src",
    "COMMIT.md",
    "README.md"
  ]
}
